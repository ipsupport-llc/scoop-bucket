    "license": "Apache-2.0",
    "notes": [
        "Settings and logs are in %LOCALAPPDATA%\\LLMTray, models in %USERPROFILE%\\.llmtray\\models; Scoop leaves both alone.",
        "Update with 'scoop update llmtray' (quit LLMTray first), not the app's own updater, so Scoop keeps track of the version.",
        "Betas are unsigned: if SmartScreen stops LLMTray, choose More info, then Run anyway."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v0.1.0-beta.11/LLMTray-0.1.0-beta.11-x64-portable.zip",
            "hash": "a22fb7bb4e5ff30ec8f499ac0afdde26fd220cbf30c7f8ba25de6ac9757cc3bc"
        },
        "arm64": {
            "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v0.1.0-beta.11/LLMTray-0.1.0-beta.11-ARM64-portable.zip",
            "hash": "c1e87415733815e1bc264ce92b4fc879a823bd699731ca82f677314c8abee25c"
        }
    },
    "extract_dir": "LLMTray",
    "shortcuts": [
        [
            "LLMTray.exe",
            "LLMTray"
        ]
    ],
    "checkver": {
        "url": "https://github.com/ipsupport-llc/llmtray-windows/releases.atom",
        "regex": "/releases/tag/v([\\d.]+(?:-beta\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v$version/LLMTray-$version-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v$version/LLMTray-$version-ARM64-portable.zip"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/ipsupport-llc/llmtray-windows/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == '$basename')].digest"
        }
    }
}
