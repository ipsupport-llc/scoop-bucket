{
    "version": "0.1.0-beta.5",
    "description": "Local AI runtime: runs GGUF models with llama.cpp and serves an OpenAI-compatible API at http://localhost:8765/v1, from the notification area.",
    "homepage": "https://github.com/ipsupport-llc/llmtray-windows",
    "license": "Apache-2.0",
    "notes": [
        "Settings and logs are in %LOCALAPPDATA%\\LLMTray, models in %USERPROFILE%\\.llmtray\\models; Scoop leaves both alone.",
        "Update with 'scoop update llmtray' (quit LLMTray first), not the app's own updater, so Scoop keeps track of the version.",
        "Betas are unsigned: if SmartScreen stops LLMTray, choose More info, then Run anyway."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v0.1.0-beta.5/LLMTray-0.1.0-beta.5-x64-portable.zip",
            "hash": "0c4df0031d82fe7653574f3e56d6206c6726db911e70548217b184ffe3adda66"
        },
        "arm64": {
            "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v0.1.0-beta.5/LLMTray-0.1.0-beta.5-ARM64-portable.zip",
            "hash": "898c4ce3e28eb6e7c5aa9210ed6f3bf51879a4ce89d94e87cfce5d05aaaefd05"
        }
    },
    "extract_dir": "LLMTray",
    "shortcuts": [
        [
            "LLMTray.exe",
            "LLMTray"
        ]
    ],
    "checkver": {
        "url": "https://github.com/ipsupport-llc/llmtray-windows/releases.atom",
        "regex": "/releases/tag/v([\\d.]+(?:-beta\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v$version/LLMTray-$version-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v$version/LLMTray-$version-ARM64-portable.zip"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/ipsupport-llc/llmtray-windows/releases/tags/v$version",
            "jsonpath": "$.assets[?(@.name == '$basename')].digest"
        }
    }
}
