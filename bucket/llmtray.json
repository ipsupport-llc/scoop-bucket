            "hash": "16e08640e955d33377d6a0bb1c782a4ba398e7704f29d03000eb7768bb6f1325"
        },
        "arm64": {
            "url": "https://github.com/ipsupport-llc/llmtray-windows/releases/download/v0.1.8-beta.4/LLMTray-0.1.8-beta.4-ARM64-portable.zip",
